	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#908e9d",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"string",
				"string.quoted",
				"constant.other.symbol"
			],
			"settings": {
				"foreground": "#e8be22"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.other"
			],
			"settings": {
				"foreground": "#e8be22"
			}
		},
		{
			"scope": [
				"constant.language",
				"constant.language.boolean"
			],
			"settings": {
				"foreground": "#e39cc3"
			}
		},
		{
			"scope": [
				"variable",
				"variable.other",
				"meta.definition.variable.name"
			],
			"settings": {
				"foreground": "#ebfafa"
			}
		},
		{
			"scope": [
				"variable.parameter",
				"meta.function.parameters"
			],
			"settings": {
				"foreground": "#a293da",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"variable.other.member",
				"support.variable.property",
				"meta.object-literal.key"
			],
			"settings": {
				"foreground": "#4bcef0"
			}
		},
		{
			"scope": [
				"keyword",
				"keyword.control",
				"keyword.other",
				"modifier"
			],
			"settings": {
				"foreground": "#638fdf"
			}
		},
		{
			"scope": [
				"keyword.operator",
				"punctuation",
				"meta.brace",
				"punctuation.separator",
				"punctuation.terminator"
			],
			"settings": {
				"foreground": "#908e9d"
			}
		},
		{
			"scope": [
				"storage",
				"storage.type",
				"storage.modifier"
			],
			"settings": {
				"foreground": "#4bcef0"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call.generic"
			],
			"settings": {
				"foreground": "#e39cc3"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"entity.name.namespace",
				"support.type",
				"support.class"
			],
			"settings": {
				"foreground": "#4bcef0"
			}
		},
		{
			"scope": [
				"entity.name.tag",
				"support.constant.handlebars"
			],
			"settings": {
				"foreground": "#4bcef0"
			}
		},
		{
			"scope": [
				"entity.other.attribute-name",
				"meta.attribute"
			],
			"settings": {
				"foreground": "#a293da"
			}
		},
		{
			"scope": [
				"support.constant",
				"support.type.property-name"
			],
			"settings": {
				"foreground": "#4bcef0"
			}
		},
		{
			"scope": [
				"markup.heading",
				"markup.heading entity.name"
			],
			"settings": {
				"foreground": "#04d1f9",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.bold"
			],
			"settings": {
				"foreground": "#e8be22",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.italic"
			],
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"markup.inserted"
			],
			"settings": {
				"foreground": "#37f499"
			}
		},
		{
			"scope": [
				"markup.deleted"
			],
			"settings": {
				"foreground": "#d68095"
			}
		},
		{
			"scope": [
				"markup.changed"
			],
			"settings": {
				"foreground": "#e39cc3"
			}
		},
		{
			"scope": [
				"markup.underline.link",
				"string.other.link"
			],
			"settings": {
				"foreground": "#a293da",
				"fontStyle": "underline"
			}
		},
		{
			"scope": [
				"invalid",
				"invalid.illegal"
			],
			"settings": {
				"foreground": "#d68095"
			}
		}
	],
	"semanticTokenColors": {
		"parameter": "#a293da",
		"property": "#4bcef0",
		"variable": "#ebfafa",
		"function": "#e39cc3",
		"method": "#e39cc3",
		"class": "#4bcef0",
		"type": "#4bcef0",
		"enum": "#4bcef0",
		"interface": "#4bcef0",
		"keyword": "#638fdf",
		"namespace": "#ebfafa"
	}
}
