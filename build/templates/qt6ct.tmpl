# Static Gospel@@name_suffix@@ - qt6ct color scheme
# Point qt6ct.conf's [Appearance] color_scheme_path at this file
# (with custom_palette=true) to apply.
#
# active_colors/disabled_colors/inactive_colors are QPalette::ColorRole values
# in enum order (WindowText..PlaceholderText, then Accent added in Qt 6.6) -
# confirmed from qt6ct's loadColorScheme(), which reads QPalette::ColorRole(i)
# at index i. All 22 slots are spelled out explicitly (rather than relying on
# qt6ct's Accent auto-pad, which only covers active/disabled, not inactive -
# a 21-value inactive array fails the NColorRoles length check on Qt >= 6.6
# and silently drops the whole custom palette).
[ColorScheme]
active_colors=#@@text@@, #@@surface@@, #@@overlay@@, #@@hl_high@@, #@@hl_low@@, #@@hl_med@@, #@@text@@, #@@b_white7@@, #@@text@@, #@@base@@, #@@base@@, #@@_nc@@, #@@selection@@, #@@text@@, #@@ember@@, #@@shroud@@, #@@surface@@, #@@base@@, #@@overlay@@, #@@text@@, #@@ash@@, #@@selection@@
disabled_colors=#@@ash@@, #@@surface@@, #@@overlay@@, #@@hl_high@@, #@@hl_low@@, #@@hl_med@@, #@@ash@@, #@@ash@@, #@@ash@@, #@@base@@, #@@base@@, #@@_nc@@, #@@hl_med@@, #@@ash@@, #@@ash@@, #@@ash@@, #@@surface@@, #@@base@@, #@@overlay@@, #@@ash@@, #@@ash@@, #@@hl_med@@
inactive_colors=#@@text@@, #@@surface@@, #@@overlay@@, #@@hl_high@@, #@@hl_low@@, #@@hl_med@@, #@@text@@, #@@b_white7@@, #@@text@@, #@@base@@, #@@base@@, #@@_nc@@, #@@hl_med@@, #@@text@@, #@@ember@@, #@@shroud@@, #@@surface@@, #@@base@@, #@@overlay@@, #@@text@@, #@@ash@@, #@@hl_med@@
