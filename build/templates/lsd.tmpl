# Static Gospel@@name_suffix@@ - lsd
# place at ~/.config/lsd/colors.yaml (lsd reads it directly), or point lsd at it.

user: "#@@witchfire@@"
group: "#@@ash@@"
permission:
  read: "#@@blight@@"
  write: "#@@witchfire@@"
  exec: "#@@ichor@@"
  exec-sticky: "#@@umbra@@"
  no-access: "#@@ash@@"
  octal: "#@@aether@@"
  acl: "#@@aether@@"
  context: "#@@umbra@@"
date:
  hour-old: "#@@blight@@"
  day-old: "#@@aether@@"
  older: "#@@ash@@"
size:
  none: "#@@ash@@"
  small: "#@@blight@@"
  medium: "#@@witchfire@@"
  large: "#@@ichor@@"
inode:
  valid: "#@@umbra@@"
  invalid: "#@@ash@@"
links:
  valid: "#@@umbra@@"
  invalid: "#@@ash@@"
tree-edge: "#@@border@@"
git-status:
  default: "#@@text@@"
  unmodified: "#@@ash@@"
  ignored: "#@@ash@@"
  new-in-index: "#@@blight@@"
  new-in-workdir: "#@@blight@@"
  typechange: "#@@witchfire@@"
  deleted: "#@@ichor@@"
  modified: "#@@witchfire@@"
  renamed: "#@@aether@@"
  conflicted: "#@@ichor@@"
