/* Static Gospel@@name_suffix@@ - GTK3/GTK4 (libadwaita named colors)
 * @import this from ~/.config/gtk-3.0/gtk.css and ~/.config/gtk-4.0/gtk.css
 * (works with adw-gtk3 / adw-gtk3-dark)
 */

@define-color accent_color #@@aether@@;
@define-color accent_fg_color #@@base@@;
@define-color accent_bg_color #@@aether@@;
@define-color window_bg_color #@@base@@;
@define-color window_fg_color #@@text@@;
@define-color headerbar_bg_color #@@surface@@;
@define-color headerbar_fg_color #@@text@@;
@define-color popover_bg_color #@@overlay@@;
@define-color popover_fg_color #@@text@@;
@define-color view_bg_color #@@base@@;
@define-color view_fg_color #@@text@@;
@define-color card_bg_color #@@surface@@;
@define-color card_fg_color #@@text@@;
@define-color sidebar_bg_color @window_bg_color;
@define-color sidebar_fg_color @window_fg_color;
@define-color sidebar_border_color @window_bg_color;
@define-color sidebar_backdrop_color @window_bg_color;
