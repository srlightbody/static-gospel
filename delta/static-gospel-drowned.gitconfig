# Static Gospel Drowned - delta
# include from ~/.gitconfig:
#   [include]
#       path = ~/.config/delta/static-gospel-drowned.gitconfig
# syntax-theme expects static-gospel-drowned.tmTheme on the bat themes path (bat names themes
# by file stem).

[delta]
	syntax-theme = static-gospel-drowned
	line-numbers = true

	minus-style = syntax "#4c222e"
	minus-emph-style = syntax "#702638"
	plus-style = syntax "#1a503d"
	plus-emph-style = syntax "#20714f"

	line-numbers-minus-style = "#ff3860"
	line-numbers-plus-style = "#37f499"
	line-numbers-zero-style = "#6e7487"
	line-numbers-left-style = "#293338"
	line-numbers-right-style = "#293338"

	file-style = "#04d1f9" bold
	file-decoration-style = "#293338" ul
	hunk-header-style = "#ff8506" bold
	hunk-header-decoration-style = "#293338" box

	zero-style = syntax
	whitespace-error-style = "#ff3860" reverse
