# Static Gospel Void - delta
# include from ~/.gitconfig:
#   [include]
#       path = ~/.config/delta/static-gospel-void.gitconfig
# syntax-theme expects static-gospel-void.tmTheme on the bat themes path (bat names themes
# by file stem).

[delta]
	syntax-theme = static-gospel-void
	line-numbers = true

	minus-style = syntax "#3a1f2a"
	minus-emph-style = syntax "#5a2535"
	plus-style = syntax "#16302a"
	plus-emph-style = syntax "#1d4a3e"

	line-numbers-minus-style = "#ff3860"
	line-numbers-plus-style = "#37f499"
	line-numbers-zero-style = "#6e7487"
	line-numbers-left-style = "#26233a"
	line-numbers-right-style = "#26233a"

	file-style = "#04d1f9" bold
	file-decoration-style = "#26233a" ul
	hunk-header-style = "#b48eff" bold
	hunk-header-decoration-style = "#26233a" box

	zero-style = syntax
	whitespace-error-style = "#ff3860" reverse
