# Static Gospel Lifted - delta
# include from ~/.gitconfig:
#   [include]
#       path = ~/.config/delta/static-gospel-lifted.gitconfig
# syntax-theme expects static-gospel-lifted.tmTheme on the bat themes path (bat names themes
# by file stem).

[delta]
	syntax-theme = static-gospel-lifted
	line-numbers = true

	minus-style = syntax "#492734"
	minus-emph-style = syntax "#6d2a3d"
	plus-style = syntax "#175643"
	plus-emph-style = syntax "#1d7554"

	line-numbers-minus-style = "#ff3860"
	line-numbers-plus-style = "#37f499"
	line-numbers-zero-style = "#6e7487"
	line-numbers-left-style = "#26363d"
	line-numbers-right-style = "#26363d"

	file-style = "#04d1f9" bold
	file-decoration-style = "#26363d" ul
	hunk-header-style = "#ff8506" bold
	hunk-header-decoration-style = "#26363d" box

	zero-style = syntax
	whitespace-error-style = "#ff3860" reverse
