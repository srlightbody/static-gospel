# Static Gospel - delta
# include from ~/.gitconfig:
#   [include]
#       path = ~/.config/delta/static-gospel.gitconfig
# syntax-theme expects static-gospel.tmTheme on the bat themes path (bat names themes
# by file stem).

[delta]
	syntax-theme = static-gospel
	line-numbers = true

	minus-style = syntax "#4e1130"
	minus-emph-style = syntax "#71193a"
	plus-style = syntax "#1c403e"
	plus-emph-style = syntax "#216450"

	line-numbers-minus-style = "#ff3860"
	line-numbers-plus-style = "#37f499"
	line-numbers-zero-style = "#6e7487"
	line-numbers-left-style = "#26233a"
	line-numbers-right-style = "#26233a"

	file-style = "#04d1f9" bold
	file-decoration-style = "#26233a" ul
	hunk-header-style = "#ff8506" bold
	hunk-header-decoration-style = "#26233a" box

	zero-style = syntax
	whitespace-error-style = "#ff3860" reverse
