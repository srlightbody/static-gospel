# Static Gospel Abyssal - delta
# include from ~/.gitconfig:
#   [include]
#       path = ~/.config/delta/static-gospel-abyssal.gitconfig
# syntax-theme expects static-gospel-abyssal.tmTheme on the bat themes path (bat names themes
# by file stem).

[delta]
	syntax-theme = static-gospel-abyssal
	line-numbers = true

	minus-style = syntax "#471a30"
	minus-emph-style = syntax "#6c203a"
	plus-style = syntax "#15493e"
	plus-emph-style = syntax "#1c6b50"

	line-numbers-minus-style = "#ff3860"
	line-numbers-plus-style = "#37f499"
	line-numbers-zero-style = "#6e7487"
	line-numbers-left-style = "#222a3a"
	line-numbers-right-style = "#222a3a"

	file-style = "#04d1f9" bold
	file-decoration-style = "#222a3a" ul
	hunk-header-style = "#ff8506" bold
	hunk-header-decoration-style = "#222a3a" box

	zero-style = syntax
	whitespace-error-style = "#ff3860" reverse
