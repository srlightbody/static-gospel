# Static Gospel Chrome - delta
# include from ~/.gitconfig:
#   [include]
#       path = ~/.config/delta/static-gospel-chrome.gitconfig
# syntax-theme expects static-gospel-chrome.tmTheme on the bat themes path (bat names themes
# by file stem).

[delta]
	syntax-theme = static-gospel-chrome
	line-numbers = true

	minus-style = syntax "#441e21"
	minus-emph-style = syntax "#6a2424"
	plus-style = syntax "#124d3b"
	plus-emph-style = syntax "#1a6e4e"

	line-numbers-minus-style = "#ff3b30"
	line-numbers-plus-style = "#37f499"
	line-numbers-zero-style = "#6b7a8f"
	line-numbers-left-style = "#1e2f36"
	line-numbers-right-style = "#1e2f36"

	file-style = "#00eaff" bold
	file-decoration-style = "#1e2f36" ul
	hunk-header-style = "#ff8a1f" bold
	hunk-header-decoration-style = "#1e2f36" box

	zero-style = syntax
	whitespace-error-style = "#ff3b30" reverse
