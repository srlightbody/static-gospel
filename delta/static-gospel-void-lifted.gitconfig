# Static Gospel Void Lifted - delta
# include from ~/.gitconfig:
#   [include]
#       path = ~/.config/delta/static-gospel-void-lifted.gitconfig
# syntax-theme expects static-gospel-void-lifted.tmTheme on the bat themes path (bat names themes
# by file stem).

[delta]
	syntax-theme = static-gospel-void-lifted
	line-numbers = true

	minus-style = syntax "#521633"
	minus-emph-style = syntax "#751c3c"
	plus-style = syntax "#204441"
	plus-emph-style = syntax "#256853"

	line-numbers-minus-style = "#ff3860"
	line-numbers-plus-style = "#37f499"
	line-numbers-zero-style = "#6e7487"
	line-numbers-left-style = "#333048"
	line-numbers-right-style = "#333048"

	file-style = "#04d1f9" bold
	file-decoration-style = "#333048" ul
	hunk-header-style = "#ff8506" bold
	hunk-header-decoration-style = "#333048" box

	zero-style = syntax
	whitespace-error-style = "#ff3860" reverse
